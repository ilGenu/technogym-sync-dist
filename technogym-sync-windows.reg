[HKEY_LOCAL_MACHINE\SOFTWARE\Policies\Google\Chrome\ExtensionInstallForcelist]
"1"="omhjkdfnkanejanndbdimcilimhbkphn;https://raw.githubusercontent.com/ilGenu/technogym-sync-dist/main/update.xml"

