  "mywellness": {
    "origin": "https://pronext.mywellness.com",
    "recipeVersion": 4,
    "startUrl": "https://pronext.mywellness.com/home",
    "loggedOut": {
      "anyOf": [
        {
          "css": "input[type=\"password\"]"
        },
        {
          "textContains": "accedi"
        },
        {
          "textContains": "sign in"
        }
      ]
    },
    "catalog": {
      "capturedAt": null,
      "itemCss": "",
      "nameCss": "",
      "url": ""
    },
    "recipe": [
      {
        "action": "navigate",
        "id": "open",
        "label": "Apro MyWellness",
        "value": "https://pronext.mywellness.com/home"
      },
      {
        "action": "requireLogin",
        "id": "login",
        "label": "Verifico il login"
      },
      {
        "action": "fill",
        "id": "search-fill",
        "label": "Cerco il cliente per email",
        "target": {
          "css": "#quick-search"
        },
        "value": "{{email}}"
      },
      {
        "action": "pressKey",
        "id": "search-submit",
        "label": "Avvio la ricerca",
        "target": {
          "css": "#quick-search"
        },
        "value": "Enter"
      },
      {
        "action": "waitFor",
        "id": "search-wait",
        "label": "Attendo i risultati",
        "target": {
          "textContains": "risultati per"
        }
      },
      {
        "action": "assertCount",
        "id": "search-count",
        "label": "Controllo che il cliente sia uno solo",
        "target": {
          "css": "[role=\"button\"].MuiListItem-root:not(.navigation-menu *)"
        },
        "value": 1
      },
      {
        "action": "click",
        "id": "search-pick",
        "label": "Apro la scheda del cliente",
        "target": {
          "css": "[role=\"button\"].MuiListItem-root:not(.navigation-menu *)"
        }
      },
      {
        "action": "assertText",
        "id": "verify-person",
        "label": "Conferma email sulla scheda (se mostrata)",
        "optional": true,
        "target": {
          "textContains": "{{email}}"
        },
        "timeoutMs": 6000
      },
      {
        "action": "click",
        "id": "open-purchases",
        "label": "Apro la sezione Acquisti",
        "target": {
          "text": "acquisti"
        }
      },
      {
        "action": "click",
        "id": "add-purchase",
        "label": "Nuovo acquisto (+)",
        "target": {
          "css": ".MuiIconButton-root",
          "near": {
            "text": "acquisti",
            "up": 1
          }
        }
      },
      {
        "action": "waitFor",
        "id": "shop-wait",
        "label": "Attendo la schermata prodotti",
        "target": {
          "textContains": "vendi prodotti"
        }
      },
      {
        "action": "fill",
        "id": "product-search",
        "label": "Filtro il listino",
        "optional": true,
        "target": {
          "css": ".MuiDialog-root input[placeholder=\"Cerca\"]"
        },
        "value": "{{mwProduct}}"
      },
      {
        "action": "pickFromList",
        "attempts": 3,
        "confirm": {
          "text": "attiva"
        },
        "id": "product-pick",
        "label": "Seleziono il prodotto",
        "target": {
          "css": ".MuiDialog-root .MuiGrid-item.MuiGrid-grid-xs-4"
        },
        "value": "{{mwProduct}}"
      },
      {
        "action": "waitFor",
        "id": "check-zero",
        "label": "Controllo che il carrello sia a 0 €",
        "target": {
          "text": "attiva"
        },
        "timeoutMs": 8000
      },
      {
        "action": "click",
        "confirmStep": true,
        "id": "finalize",
        "label": "Completo la vendita a 0 €",
        "target": {
          "anyOf": [
            {
              "tag": "button",
              "text": "attiva"
            },
            {
              "text": "attiva"
            }
          ]
        }
      },
      {
        "action": "waitGone",
        "id": "verify",
        "label": "Verifico l'esito",
        "skipOnDryRun": true,
        "target": {
          "textContains": "vendi prodotti"
        }
      }
    ]
  },
